{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "ext-zip": "*",
        "barryvdh/laravel-snappy": "^1.0",
        "cyrildewit/eloquent-viewable": "^7.0",
        "ejarnutowski/laravel-api-key": "^1.0",
        "guzzlehttp/guzzle": "^7.2",
        "h4cc/wkhtmltopdf-amd64": "^0.12.4",
        "jeremykenedy/laravel-logger": "^9.0",
        "laracasts/flash": "^3.2",
        "laravel/framework": "^10.10",
        "laravel/sanctum": "^3.2",
        "laravel/tinker": "^2.8",
        "livewire/livewire": "^3.4.3",
        "maatwebsite/excel": "^3.1",
        "mcamara/laravel-localization": "^1.8",
        "mews/captcha": "^3.3",
        "nebed/laravel-ua-parser": "^1.0",
        "opcodesio/log-viewer": "^3.1",
        "rawilk/laravel-settings": "^3.3",
        "spatie/laravel-activitylog": "^4.7",
        "spatie/laravel-backup": "^8.3",
        "spatie/laravel-data": "^4.5",
        "spatie/laravel-html": "^3.3",
        "spatie/laravel-log-dumper": "^1.5",
        "spatie/laravel-medialibrary": "^10.15",
        "spatie/laravel-menu": "^4.2",
        "spatie/laravel-permission": "^6.1",
        "spatie/laravel-sitemap": "^7.0",
        "spatie/laravel-translatable": "^6.6",
        "wemersonjanuario/wkhtmltopdf-windows": "0.12.2.3",
        "wireui/wireui": "^1.17",
        "yajra/laravel-datatables": "10.0",
        "yajra/laravel-datatables-buttons": "^10.0",
        "yajra/laravel-datatables-html": "^10.12",
        "yajra/laravel-datatables-oracle": "10.3.1"
    },
    "require-dev": {
        "doctrine/dbal": "^3.8",
        "fakerphp/faker": "^1.9.1",
        "jasonmccreary/laravel-test-assertions": "^2.3",
        "laravel-shift/blueprint": "^2.10",
        "laravel/dusk": "^8.2",
        "laravel/pint": "^1.0",
        "laravel/sail": "^1.18",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^7.0",
        "pestphp/pest": "^2.34",
        "pestphp/pest-plugin-faker": "^2.0",
        "pestphp/pest-plugin-laravel": "^2.3",
        "phpunit/phpunit": "^10.1",
        "spatie/laravel-ignition": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Helpers/functions.php",
            "app/Helpers/languages.php",
            "app/Helpers/ajax_actions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
